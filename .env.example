# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Settings -> API no painel do Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API da Anthropic (console.anthropic.com -> API keys).
# Fica so no servidor: NAO use o prefixo NEXT_PUBLIC_, senao ela vai para o navegador.
# Na Vercel, cadastre como variavel de ambiente comum (Production e Preview).
ANTHROPIC_API_KEY=

# Opcional: troca o modelo usado nas funcoes de IA (padrao: claude-opus-5-5).
# ANTHROPIC_MODEL=
