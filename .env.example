# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Settings -> API no painel do Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provedor de IA: "google" (Gemini, padrao) ou "anthropic" (Claude, em standby).
# Esta variavel tambem define o que as telas dizem sobre privacidade.
NEXT_PUBLIC_IA_PROVEDOR=google

# --- Google (Gemini) ---
# Chave em aistudio.google.com/apikey. Fica so no servidor: NAO use NEXT_PUBLIC_.
# Atencao: no plano gratuito o Google pode usar o conteudo enviado para melhorar
# os produtos dele. Nele, use apenas documentos sem dados reais.
GEMINI_API_KEY=
# Opcional: troca o modelo (padrao: gemini-3.6-flash).
# GEMINI_MODEL=
# Opcional: low | medium | high. "low" deixa a resposta bem mais rapida
# (medido: ~5 s contra ~18 a 59 s) com menos profundidade de analise.
# GEMINI_THINKING=

# --- Anthropic (Claude), usado so se NEXT_PUBLIC_IA_PROVEDOR=anthropic ---
# Chave em console.anthropic.com -> API keys. Pre-paga (exige cartao).
ANTHROPIC_API_KEY=
# Opcional: troca o modelo (padrao: claude-opus-5-5).
# ANTHROPIC_MODEL=

# Na Vercel, cadastre estas variaveis como variaveis de ambiente comuns
# (Production e Preview). Chaves de API nunca com o prefixo NEXT_PUBLIC_.
